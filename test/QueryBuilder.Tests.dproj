<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7C52E49A-9572-44E3-93C9-2C8A62D66F42}</ProjectGuid>
        <MainSource>QueryBuilder.Tests.dpr</MainSource>
        <Base>True</Base>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>20.1</ProjectVersion>
        <TargetedPlatforms>3</TargetedPlatforms>
        <Config Condition="'$(Config)'==''">Base</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <DCC_Namespace>System;Xml;Data;Winapi;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>..\src;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>..\src;$(BDS)\source\DUnitX;$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_ExeOutput>..\build\$(Platform)</DCC_ExeOutput>
        <DCC_DcuOutput>..\build\$(Platform)\dcu</DCC_DcuOutput>
        <DCC_ConsoleTarget>true</DCC_ConsoleTarget>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInformation>1</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <ProjectName Condition="'$(ProjectName)'==''">QueryBuilder.Tests</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>QueryBuilder_Tests</SanitizedProjectName>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Query.Core.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Query.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Query.Writes.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Query.DataMapper.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.Compiler.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.SqlServerCompiler.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.PostgresCompiler.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.MySqlCompiler.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.SqliteCompiler.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.OracleCompiler.pas"/>
        <DCCReference Include="..\src\QueryBuilder4Delphi.Compilers.FirebirdCompiler.pas"/>
        <DCCReference Include="Execution.ProviderExample.pas"/>
        <DCCReference Include="Execution.Mock.pas"/>
        <DCCReference Include="Execution.Tests.pas"/>
        <DCCReference Include="DocumentationExamples.pas"/>
        <DCCReference Include="CompilerClasses.Tests.pas"/>
        <DCCReference Include="QueryWrites.Tests.pas"/>
        <DCCReference Include="QueryModel.Tests.pas"/>
        <DCCReference Include="Oracle.Scenarios.pas"/>
        <DCCReference Include="QueryBuilder.Tests.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Console</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">QueryBuilder.Tests.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
